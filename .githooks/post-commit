#!/usr/bin/env bash
# Git post-commit hook: Launches asynchronous AI code review in the background
# Commit finishes immediately with zero terminal latency.

if [ "$SKIP_AI" = "1" ] || [ "$SKIP_BACKGROUND_REVIEW" = "1" ]; then
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo ".")"
REVIEWER_SCRIPT="$REPO_ROOT/scripts/git-background-reviewer.py"

if [ ! -f "$REVIEWER_SCRIPT" ]; then
    exit 0
fi

COMMIT_SHA="$(git rev-parse HEAD 2>/dev/null)"
if [ -z "$COMMIT_SHA" ]; then
    exit 0
fi

# Spawn background reviewer detached from current terminal session
nohup python3 "$REVIEWER_SCRIPT" "$COMMIT_SHA" > /dev/null 2>&1 &
REVIEW_PID=$!

SHORT_SHA="${COMMIT_SHA:0:8}"
echo -e "\033[96m🤖 Asynchronous AI Review initiated for commit \033[1m${SHORT_SHA}\033[0m\033[96m (gated on git push)\033[0m"

exit 0
