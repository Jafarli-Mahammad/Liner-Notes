#!/usr/bin/env bash
# Fast-path Git pre-commit hook (< 10ms)
# Only checks for critical hardcoded credentials (private keys, cloud tokens)
# to prevent secrets from entering Git history.
# Full QA and Security reviews run asynchronously in the background post-commit.

if [ "$SKIP_PRE_COMMIT" = "1" ] || [ "$SKIP_AI" = "1" ]; then
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo ".")"

# Check staged diff for private keys and cloud credentials
STAGED_DIFF=$(git diff --cached --unified=0 2>/dev/null)

if [ -n "$STAGED_DIFF" ]; then
    # 1. Private keys
    if echo "$STAGED_DIFF" | grep -Eq '^\+.*-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----'; then
        echo -e "\033[91m\033[1m🛑 COMMIT REJECTED: Hardcoded Private Key detected in staged files!\033[0m"
        echo -e "\033[93mPlease remove sensitive keys and store them in secure environment variables or vault.\033[0m"
        exit 1
    fi

    # 2. AWS tokens
    if echo "$STAGED_DIFF" | grep -Eq '^\+.*\b(AKIA|ABIA|ACCA|ASIA)[0-9A-Z]{16}\b'; then
        echo -e "\033[91m\033[1m🛑 COMMIT REJECTED: AWS Access Key ID detected in staged files!\033[0m"
        exit 1
    fi

    # 3. GitHub Personal Access Tokens
    if echo "$STAGED_DIFF" | grep -Eq '^\+.*\bgh[pousr]_[A-Za-z0-9_]{36,}\b'; then
        echo -e "\033[91m\033[1m🛑 COMMIT REJECTED: GitHub Token detected in staged files!\033[0m"
        exit 1
    fi
fi

exit 0
