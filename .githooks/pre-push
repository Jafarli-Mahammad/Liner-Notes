#!/usr/bin/env bash
# Git pre-push hook: Enforces asynchronous AI code review gate.
# Verifies that all unpushed commits have completed review and passed without Critical/High issues.

if [ "$SKIP_AI" = "1" ] || [ "$SKIP_REVIEW_GATE" = "1" ]; then
    echo -e "\033[93m[pre-push] SKIP_REVIEW_GATE=1 detected; bypassing review gate.\033[0m"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo ".")"
REVIEWS_DIR="$REPO_ROOT/.git/reviews"
REVIEWER_SCRIPT="$REPO_ROOT/scripts/git-background-reviewer.py"

mkdir -p "$REVIEWS_DIR"

# Collect all unpushed commit hashes to check
COMMITS_TO_CHECK=()

# 1. Parse standard pre-push input from stdin
if [ ! -t 0 ]; then
    while read -r local_ref local_sha remote_ref remote_sha; do
        if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
            # Branch deletion; skip
            continue
        fi

        if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
            # New remote branch: check commits not in any remote
            while IFS= read -r sha; do
                [ -n "$sha" ] && COMMITS_TO_CHECK+=("$sha")
            done < <(git rev-list "$local_sha" --not --remotes 2>/dev/null)
        else
            while IFS= read -r sha; do
                [ -n "$sha" ] && COMMITS_TO_CHECK+=("$sha")
            done < <(git rev-list "$remote_sha..$local_sha" 2>/dev/null)
        fi
    done
fi

# 2. Fallback if no stdin was provided (e.g., manual check)
if [ ${#COMMITS_TO_CHECK[@]} -eq 0 ]; then
    UPSTREAM_TRACKING="$(git rev-parse --abbrev-ref @{u} 2>/dev/null)"
    if [ -n "$UPSTREAM_TRACKING" ]; then
        while IFS= read -r sha; do
            [ -n "$sha" ] && COMMITS_TO_CHECK+=("$sha")
        done < <(git rev-list @{u}..HEAD 2>/dev/null)
    else
        # No upstream configured: check HEAD commit
        CURRENT_HEAD="$(git rev-parse HEAD 2>/dev/null)"
        [ -n "$CURRENT_HEAD" ] && COMMITS_TO_CHECK+=("$CURRENT_HEAD")
    fi
fi

if [ ${#COMMITS_TO_CHECK[@]} -eq 0 ]; then
    exit 0
fi

echo -e "\033[96m🛡️  Checking AI review verdicts for ${#COMMITS_TO_CHECK[@]} unpushed commit(s)...\033[0m"

FAILED=0

for COMMIT in "${COMMITS_TO_CHECK[@]}"; do
    SHORT_SHA="${COMMIT:0:8}"
    JSON_FILE="$REVIEWS_DIR/${COMMIT}.json"
    MD_FILE="$REVIEWS_DIR/${COMMIT}.md"

    # If review file does not exist, trigger synchronous review now
    if [ ! -f "$JSON_FILE" ]; then
        echo -e "\033[93m⏳ Commit ${SHORT_SHA} has not been reviewed yet. Running review now...\033[0m"
        python3 "$REVIEWER_SCRIPT" "$COMMIT"
    fi

    # If review is still IN_PROGRESS, wait for it
    MAX_WAIT=90
    WAITED=0
    while [ -f "$JSON_FILE" ] && grep -q '"status":\s*"IN_PROGRESS"' "$JSON_FILE"; do
        if [ $WAITED -ge $MAX_WAIT ]; then
            echo -e "\n\033[93m⚠️  Review timeout exceeded for commit ${SHORT_SHA}. Allowing push under timeout policy.\033[0m"
            break
        fi
        echo -ne "\033[2K\r\033[96m⏳ Waiting for background review of commit ${SHORT_SHA} (${WAITED}s)... \033[0m"
        sleep 2
        WAITED=$((WAITED + 2))
    done

    # Check status and verdict
    if [ -f "$JSON_FILE" ]; then
        if grep -q '"verdict":\s*"REJECT"' "$JSON_FILE"; then
            echo -e "\n\033[91m\033[1m🛑 PUSH BLOCKED: Commit ${SHORT_SHA} failed AI Code Review!\033[0m\n"
            if [ -f "$MD_FILE" ]; then
                cat "$MD_FILE"
                echo ""
            fi
            echo -e "\033[93mTo fix: Address the issues listed above, commit fixes, and try pushing again.\033[0m"
            echo -e "\033[2m(To emergency bypass this gate: SKIP_REVIEW_GATE=1 git push)\033[0m\n"
            FAILED=1
            break
        else
            echo -e "\033[92m✅ Commit ${SHORT_SHA}: PASSED (Approved)\033[0m"
        fi
    fi
done

if [ $FAILED -ne 0 ]; then
    exit 1
fi

echo -e "\033[92m\033[1m🚀 All unpushed commits passed review! Proceeding with push...\033[0m\n"
exit 0
