[Unit]
Description=Liner Notes verified encrypted backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=linernotes
WorkingDirectory=/opt/linernotes
UMask=0077
ExecStart=/usr/bin/python3 /opt/linernotes/scripts/ops/production.py --configuration /srv/linernotes/operations.json backup
TimeoutStartSec=2h
Nice=10
MemoryMax=512M
