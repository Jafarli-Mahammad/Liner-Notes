[Unit]
Description=Liner Notes bounded weekly scheduling and email dispatch
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=linernotes
WorkingDirectory=/opt/linernotes
UMask=0077
ExecStart=/usr/bin/python3 /opt/linernotes/scripts/ops/production.py --configuration /srv/linernotes/operations.json mail
TimeoutStartSec=660s
MemoryMax=128M
