{

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Generation": {
    "Provider": "listenbrainz",
    "LiveEnabled": false
  },
  "ListenBrainz": {
    "Mode": "FixtureOnly",
    "LiveUseApproved": false,
    "MaximumRequests": 80,
    "CacheSeconds": 900
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "LinerNotes",
    "Audience": "LinerNotesAudience",
    "ExpiryMinutes": 15
  }
}
