<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LinerNotes.Infrastructure.Tests</RootNamespace>
    <AssemblyName>LinerNotes.Infrastructure.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UserSecretsId>linernotes-secrets-app-v1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Application\Application.csproj" />
    <ProjectReference Include="..\..\src\Domain\Domain.csproj" />
    <Compile Include="..\Application.Tests\Common\FixtureEvaluationHarness.cs" Link="RecommendationSources\FixtureEvaluationHarness.cs" />
    <Compile Include="..\Application.Tests\Common\Phase2ProfileMembership.cs" Link="RecommendationSources\Phase2ProfileMembership.cs" />
    <Compile Include="..\Application.Tests\Common\EvaluationMetrics.cs" Link="RecommendationSources\EvaluationMetrics.cs" />
    <Compile Include="..\Application.Tests\Common\PilotScoring.cs" Link="RecommendationSources\PilotScoring.cs" />
    <Compile Include="..\Application.Tests\Common\PilotEvaluation.cs" Link="RecommendationSources\PilotEvaluation.cs" />
    <EmbeddedResource Include="..\..\scripts\phase4_weights.json" LogicalName="LinerNotes.Pilot.Weights.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.msbuild" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
  </ItemGroup>

</Project>
